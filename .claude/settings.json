{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python3 *)",
      "Bash(docker compose *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "./scripts/vagt-groen.sh" }
        ]
      }
    ]
  }
}
