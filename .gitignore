# --- Hemmeligheder ------------------------------------------------------
# De rigtige udgaver af disse filer må ALDRIG committes. Kopiér .example-
# filerne, udfyld dem lokalt, og lad dem blive liggende her.
.env
deploy/Caddyfile
deploy/authelia/configuration.yml
deploy/authelia/users_database.yml
deploy/authelia/db.sqlite3
deploy/authelia/notification.txt
*.pem
*.key

# --- Runtime-data -------------------------------------------------------
# Databasen indeholder jeres domme og brugere. Den hører hjemme i backup,
# ikke i git.
data-runtime/
data/*.db
data/*.db-wal
data/*.db-shm
pgdata/
caddy/

# scripts/hent-korpus.py lægger som standard i ~/allergiscan-korpus, altså
# UDEN FOR repoet — men er dette alligevel de sikkerhedslag, der holder
# den ude, hvis nogen nogensinde peger den herind. Ankret med et
# indledende "/": et uankret mønster som "korpus/" matcher i ENHVER
# dybde og fik `_sikker_destination()` i scripts/hent-korpus.py til
# fejlagtigt at regne app/static/korpus, data/korpus og app/korpus for
# "sikre". Scriptets egen vagt stoler ikke længere på denne fil (den
# afviser nu ubetinget alt inde i repoet) — dette er kun det andet lag.
/allergiscan-korpus/
/korpus/

# --- Billeder af familiens egne pakker -----------------------------------
# Andet lag ud over hygiene-jobbet i .github/workflows/deploy.yml, som
# afviser dem, hvis de alligevel bliver committet. Spejl listen, hvis den
# ene ændres — de skal blive ved med at dække det samme.
*.jpg
*.jpeg
*.png
*.heic
*.webp
*.gif
*.tiff
*.tif
*.bmp
!app/static/apple-touch-icon.png

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Auto-deploy (tilstand på serveren, se deploy/autodeploy.sh) --------
.deploy-state
.deploy-lock

# --- Familiens eget regneark --------------------------------------------
# Det er jeres data, ikke kodens. Må aldrig committes, indsættes i en
# issue eller bruges som testfixture. Se .claude/skills/familiens-data.
*.xlsx
*.xls
*.ods
liste*.csv

# --- Agentopsætning ------------------------------------------------------
# .claude/agents, /commands og /skills HØRER med i repoet — de beskriver
# projektet. Resten er maskinlokalt eller privat arbejdsmateriale.
.claude/settings.local.json
.claude/settings.json.forslag
.claude/scheduled_tasks.lock
.claude/launch.json
.claude/agent-memory/

# --- Værktøj ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
