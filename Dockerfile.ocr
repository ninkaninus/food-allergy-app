# OCR-tjenesten. Egen container, så modeller og native kode holdes væk
# fra web-appen — se ocr_service/main.py for begrundelsen.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# opencv (via rapidocr) kræver disse to; headless-varianten af opencv
# installeres nedenfor, så resten af X11-stakken ikke skal med.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ocr_service/requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

COPY ocr_service /app/ocr_service

# Varm modellerne op ved byg, så de ligger i imaget frem for at blive
# hentet ved første kald i et køkken i Netto.
RUN python -c "from rapidocr import RapidOCR; RapidOCR()"

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')"
# Samme grund som i Dockerfile: healthchecket rammer /healthz hvert 30.
# sekund, og adgangsloggen ville skrive ~2.900 linjer i døgnet uden
# rotation — plus et tidsstemplet spor over hver deklaration, der blev
# fotograferet. Fejl-logningen er urørt.
CMD ["uvicorn","ocr_service.main:app","--host","0.0.0.0","--port","8000","--no-access-log"]
