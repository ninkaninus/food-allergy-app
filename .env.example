# Kopiér til .env og udfyld. .env er gitignoreret.
#   cp .env.example .env

# --- Open Food Facts ----------------------------------------------------
# OFF beder udtrykkeligt om en beskrivende User-Agent med kontaktadresse.
# Uden den bliver du rate-limited, og det er dårlig skik.
# Versionsnummer sættes automatisk ud fra app/version.py — skriv det ikke her.
OFF_USER_AGENT=AllergiScan (selfhosted; dinmail@example.dk)

# --- Husstand -----------------------------------------------------------
HOUSEHOLD_NAME=Vores husstand
PROFILE_NAME=Barn
TZ=Europe/Copenhagen

# --- Sessioner ----------------------------------------------------------
# COOKIE_SECURE=1 kræver HTTPS. Sæt 0 hvis du tester på rent LAN over http,
# ellers sender browseren aldrig session-cookien tilbage.
COOKIE_SECURE=1
SESSION_DAYS=30

# --- Adgangskoder -------------------------------------------------------
# Slår nye adgangskoder op hos Have I Been Pwned med k-anonymitet: kun de
# første fem tegn af SHA-1-hashen forlader maskinen. Se app/auth.py.
CHECK_PWNED_PASSWORDS=1
MIN_PASSWORD_LEN=14

# --- Proxy-auth ---------------------------------------------------------
# FARLIGT hvis det sættes forkert. Slå KUN til når Caddy/Authelia står
# foran OG strimler Remote-* fra indgående requests (se deploy/Caddyfile.example).
# Uden den strimling kan hvem som helst sætte Remote-User og få skriveadgang.
TRUST_PROXY_AUTH=0
TRUSTED_PROXY_HOSTS=caddy

# --- OCR-tjenesten ------------------------------------------------------
# Kører i egen container (se docker-compose.yml). Svarer den ikke, falder
# appen tilbage til den indbyggede Tesseract-læsning — svagere, men appen
# dør ikke. Rør kun disse, hvis du flytter tjenesten et andet sted hen.
# OCR_URL=http://ocr:8000
# OCR_TIMEOUT=60
# Hold OCR fra at æde hele serveren under en scanning.
OCR_THREADS=4
OCR_CPUS=4

# --- Database -----------------------------------------------------------
# Databasen kører i egen container (postgres), men appen bruger den KUN,
# hvis DATABASE_URL er sat. Tom = SQLite-filen i /data, som hidtil.
#
# Skiftet er ét bevidst trin, fordi jeres domme skal flyttes med:
#   docker compose up -d postgres
#   docker compose run --rm allergiscan python -m app.cli migrate /data/allergiscan.db
# Migreringen nægter at køre mod en database, der ikke er tom — så I
# hverken duplikerer eller taber noget. Se deploy/UNRAID.md.
POSTGRES_PASSWORD=SKIFT_MIG
# DATABASE_URL=postgresql+psycopg://allergiscan:SAMME_SOM_OVENFOR@postgres:5432/allergiscan

# --- Cloudflare Tunnel --------------------------------------------------
# Token fra Zero Trust -> Networks -> Tunnels. Peg tunnellen på
# http://allergiscan:8000. Se deploy/cloudflared/README.md.
# TUNNEL_TOKEN=

# --- Cloudflare Access (valgfrit) ---------------------------------------
# Alternativ til lokale brugere. Appen validerer JWT'ets signatur, ikke
# bare en header — derfor kan den ikke forfalskes.
# CF_ACCESS_TEAM_DOMAIN=ditteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_ACCESS_ADMINS=dig@example.dk

# --- Gammel godkendt-liste ----------------------------------------------
# Google Sheets-link til jeres regneark (delt med 'alle med linket kan
# se'). Så henter `docker compose exec allergiscan python -m app.cli
# import` selv den nyeste udgave — ingen filer at kopiere.
# LISTE_URL=https://docs.google.com/spreadsheets/d/DIT_ARK_ID/edit

# --- Auto-deploy --------------------------------------------------------
# Sættes og vedligeholdes af deploy/autodeploy.sh — rør den ikke manuelt,
# agenten pinner den til den commit, der senest bestod tests og healthcheck.
# Udeladt = lokalt byg (docker compose up -d --build). Se deploy/UNRAID.md.
# APP_IMAGE=

# Hvilke compose-profiler `docker compose up -d` skal omfatte. VIGTIGT for
# auto-deploy: agenten kører netop den kommando, og uden tunnel-profilen her
# ville den ikke styre cloudflared. Kommasepareret, fx tunnel,postgres.
COMPOSE_PROFILES=tunnel

# --- Stier på unRAID ----------------------------------------------------
DATA_PATH=/mnt/user/appdata/allergiscan/data
PGDATA_PATH=/mnt/user/appdata/allergiscan/pgdata
CADDY_PATH=/mnt/user/appdata/allergiscan/caddy
APP_PORT=8420

# Default 127.0.0.1: appen kan kun nås gennem tunnellen og fra hosten selv
# (curl til /healthz). Sæt 0.0.0.0 for at åbne mod LAN, fx til test —
# men husk at kameraet alligevel kun virker over HTTPS.
# APP_BIND=127.0.0.1
